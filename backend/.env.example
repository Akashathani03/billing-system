# --- server ---
PORT=5000
NODE_ENV=development

# --- database ---
MONGODB_URI=mongodb://127.0.0.1:27017/mahaveer_billing

# --- auth ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=mahaveer_session

# --- cors (comma-separated if testing from another device on the LAN too) ---
CLIENT_ORIGIN=http://localhost:5173

# --- owner seed (consumed once by npm run seed, then safe to remove) ---
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=change_this_before_seeding

# --- shop config (consumed once, at shop-creation time, by npm run seed / npm run migrate:shops) ---
SHOP_NAME=Mahaveer Electrical Shop
SHOP_ADDRESS=Athani Gokak Road, Harugeri-591220
SHOP_PHONE=7411188495
SHOP_EMAIL=mahaveershop@gmail.com
INVOICE_TERMS=Goods once sold will not be taken back. Warranty as per manufacturer policy.

# --- object storage (Cloudflare R2 — manual bill photos; required in production) ---
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=mahaveer-manual-bills
R2_ACCESS_KEY_ID=change_this
R2_SECRET_ACCESS_KEY=change_this
