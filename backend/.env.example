# Copy this file to backend/.env and replace the placeholder values.
# backend/.env is git-ignored — never commit real values.

# --- server ---
PORT=5000
NODE_ENV=development

# --- database ---
MONGODB_URI=mongodb://127.0.0.1:27017/billing_system

# --- auth ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=billing_session

# --- cors (comma-separated if testing from another device on the LAN too) ---
CLIENT_ORIGIN=http://localhost:5173

# --- first owner + shop (read by `npm run seed`, which requires all three) ---
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=change_this_before_seeding
SEED_SHOP_NAME=Example Shop

# --- new-shop details (optional; applied only when `npm run seed` or `npm run migrate:shops` creates a NEW shop) ---
SHOP_ADDRESS=123 Example Street, Example City
SHOP_PHONE=555-0100
SHOP_EMAIL=shop@example.com
INVOICE_TERMS=Payment is due as agreed. Please keep this invoice for your records.

# --- legacy data migration (only for `npm run migrate:shops`; not needed for a fresh install) ---
# MIGRATE_TO_USERNAME=owner
# MIGRATE_TO_SHOP_NAME=Example Shop

# --- object storage (S3-compatible, e.g. Cloudflare R2 — manual bill photos; required in production) ---
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=your-bucket-name
R2_ACCESS_KEY_ID=change_this
R2_SECRET_ACCESS_KEY=change_this

# --- AI billing assistant (Gemini) — backend only ---
GEMINI_API_KEY=change_this
